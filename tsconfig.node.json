{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    "src/domain/deploy.ts",
    "src/domain/schema.ts",
    "src/domain/types.ts"
  ]
}
